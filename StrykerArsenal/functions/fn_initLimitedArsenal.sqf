params [["_box", objNull, [objNull, []]]];
if (_box isEqualType []) then {
	_box = _box param [0, objNull, [objNull]];
};

if (isNull _box) exitWith {};

diag_log format ["[Stryker Arsenal] Initializing limited arsenal on %1 (%2).", _box, typeOf _box];

private _serverShouldInit = false;
if (isServer) then {
	if (_box getVariable ["Stryker_arsenal_initialized", false]) then {
		diag_log format ["[Stryker Arsenal] Skipping duplicate limited arsenal init on %1 (%2).", _box, typeOf _box];
	} else {
		_box setVariable ["Stryker_arsenal_initialized", true, true];
		_serverShouldInit = true;

		clearWeaponCargoGlobal _box;
		clearMagazineCargoGlobal _box;
		clearItemCargoGlobal _box;
		clearBackpackCargoGlobal _box;

		_box setVariable ["ace_dragging_canCarry", false, true];
		_box setVariable ["ace_dragging_canDrag", false, true];
		_box setVariable ["ace_cargo_canLoad", false, true];
		_box setVariable ["ace_cargo_size", -1, true];
	};
};

