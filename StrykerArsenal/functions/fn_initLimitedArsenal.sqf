	"TCP_G_TacticalGlasses_Yellow_DP",
	"TCP_G_VisrGlasses"
];

private _items = [];
{
	if (isClass (configFile >> "CfgWeapons" >> _x)) then {
		_items pushBackUnique _x;
	};
} forEach (_weapons + _attachments + _headgear + _uniforms + _vests + _utilityItems);

{
	if (isClass (configFile >> "CfgGlasses" >> _x)) then {
		_items pushBackUnique _x;
	};
} forEach _utilityItems;

{
	if (isClass (configFile >> "CfgMagazines" >> _x)) then {
		_items pushBackUnique _x;
	};
} forEach _magazines;

{
	if (isClass (configFile >> "CfgVehicles" >> _x)) then {
		_items pushBackUnique _x;
	};
} forEach _backpacks;

if (isServer && {_serverShouldInit}) then {
	if (isNil "ace_arsenal_fnc_initBox") exitWith {
		diag_log format ["[Stryker Arsenal] ACE arsenal function is missing while initializing %1.", _box];
	};

	[_box, true, true] call ace_arsenal_fnc_removeVirtualItems;
	[_box, _items, true] call ace_arsenal_fnc_initBox;
	diag_log format ["[Stryker Arsenal] Loaded %1 explicit TCP arsenal items into %2.", count _items, _box];
};
